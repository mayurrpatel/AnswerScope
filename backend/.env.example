# Database URL (PostgreSQL for production / SQLite for local development & testing)
# PostgreSQL example: postgresql+psycopg://audit_user:your_password@localhost:5432/ai_search_audit
DATABASE_URL=sqlite:///./app.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Visibility Provider Keys (Optional: if empty, providers cleanly report unconfigured status)
# Tavily Search API key (from https://tavily.com)
TAVILY_API_KEY=

# SerpAPI Google Search API key (from https://serpapi.com)
SERPAPI_API_KEY=

# Perplexity API key
PERPLEXITY_API_KEY=

# AI Integration Keys (Optional: if empty, deterministic heuristic engine is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Crawler Safety & Rate Limits
CRAWLER_MAX_PAGES=15
CRAWLER_MAX_DEPTH=2
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_USER_AGENT=AnswerEngineAuditor/1.0 (+https://example.com/bot)
